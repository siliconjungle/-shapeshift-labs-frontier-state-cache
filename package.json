{
  "name": "@shapeshift-labs/frontier-state-cache",
  "version": "0.1.1",
  "description": "Normalized query-result cache for Frontier packages and application state.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/siliconjungle/-shapeshift-labs-frontier-state-cache.git"
  },
  "homepage": "https://github.com/siliconjungle/-shapeshift-labs-frontier-state-cache#readme",
  "bugs": {
    "url": "https://github.com/siliconjungle/-shapeshift-labs-frontier-state-cache/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./mutation": {
      "types": "./dist/mutation.d.ts",
      "import": "./dist/mutation.js",
      "default": "./dist/mutation.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "benchmarks/package-bench.mjs"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "npm run build && npm run typecheck && node test/smoke.mjs && node test/persistence.mjs && node test/mutation.mjs && node test/fuzz.mjs --cases 300",
    "prepack": "npm run test",
    "typecheck": "tsc -p test/tsconfig.json --noEmit",
    "fuzz": "npm run build && node test/fuzz.mjs",
    "bench": "npm run build && node benchmarks/package-bench.mjs",
    "pack:dry": "npm pack --dry-run"
  },
  "keywords": [
    "frontier",
    "state",
    "cache",
    "query",
    "normalized",
    "mutation"
  ],
  "dependencies": {
    "@shapeshift-labs/frontier": "^0.1.5",
    "@shapeshift-labs/frontier-query": "^0.1.0"
  },
  "peerDependencies": {
    "@shapeshift-labs/frontier-mutation": "^0.1.3"
  },
  "peerDependenciesMeta": {
    "@shapeshift-labs/frontier-mutation": {
      "optional": true
    }
  },
  "devDependencies": {
    "@shapeshift-labs/frontier-mutation": "^0.1.3",
    "typescript": "^6.0.3"
  },
  "author": "james addison"
}
